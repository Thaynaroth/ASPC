// ASPC — Automation Selling Platform in Cambodia
// Phase 1 Schema · Generated from dbdiagram.io design

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────

enum OrderStatus {
  pending
  processing
  confirmed
  payment_pending
  paid
  preparing
  delivered
  cancelled
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
}

enum PlanTier {
  free
  pro
  business
}

enum Language {
  km
  en
}

enum PlacedVia {
  bot
  pos
  manual
}

enum PaymentMethod {
  khqr
  cash
  bank_transfer
}

// ─── AUTH & USERS ────────────────────────────────

model roles {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  created_at  DateTime @default(now())

  role_permissions role_permissions[]
  user_roles       user_roles[]

  @@map("roles")
}

model permissions {
  id              String   @id @default(uuid()) @db.Uuid
  permission_code String   @unique
  name            String   @unique
  description     String?
  created_at      DateTime @default(now())

  role_permissions role_permissions[]

  @@map("permissions")
}

model role_permissions {
  id            String @id @default(uuid()) @db.Uuid
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       roles       @relation(fields: [role_id], references: [id])
  permission permissions @relation(fields: [permission_id], references: [id])

  @@map("role_permissions")
}

model users {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  phone         String?
  password_hash String
  full_name     String?
  avatar_url    String?
  address       String?
  is_verified   Boolean   @default(false)
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  user_roles       user_roles[]       @relation("UserRoleUser")
  user_preferences user_preferences?
  user_activities  user_activities[]
  shops_owned      shops[]            @relation("ShopOwner")
  assigned_roles   user_roles[]       @relation("UserRoleAssignedBy")
  orders_handled   orders[]           @relation("OrderHandledBy")

  @@map("users")
}

model user_roles {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  role_id     String    @db.Uuid
  shop_id     String?   @db.Uuid
  assigned_at DateTime  @default(now())
  assigned_by String?   @db.Uuid

  user          users  @relation("UserRoleUser", fields: [user_id], references: [id])
  role          roles  @relation(fields: [role_id], references: [id])
  shop          shops? @relation(fields: [shop_id], references: [id])
  assigned_user users? @relation("UserRoleAssignedBy", fields: [assigned_by], references: [id])

  @@unique([user_id, role_id, shop_id])
  @@map("user_roles")
}

model user_preferences {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @unique @db.Uuid
  language           Language @default(km)
  timezone           String   @default("Asia/Phnom_Penh")
  notify_new_order   Boolean  @default(true)
  notify_low_stock   Boolean  @default(true)
  notify_payment_done Boolean @default(true)
  updated_at         DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id])

  @@map("user_preferences")
}

model user_activities {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  shop_id     String?  @db.Uuid
  action      String
  entity_type String?
  ip_address  String?
  metadata    Json?
  created_at  DateTime @default(now())

  user users  @relation(fields: [user_id], references: [id])
  shop shops? @relation(fields: [shop_id], references: [id])

  @@index([user_id, created_at])
  @@index([shop_id, created_at])
  @@map("user_activities")
}

// ─── SHOP ────────────────────────────────────────

model shop_types {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  created_at  DateTime @default(now())

  shops shops[]

  @@map("shop_types")
}

model shops {
  id          String    @id @default(uuid()) @db.Uuid
  owner_id    String    @db.Uuid
  shop_type_id String?  @db.Uuid
  name        String
  slug        String    @unique
  description String?
  agent_note  String?
  logo_url    String?
  cover_url   String?
  phone       String?
  address     String?
  city        String?   @default("Phnom Penh")
  currency    String    @default("KHR")
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  owner           users            @relation("ShopOwner", fields: [owner_id], references: [id])
  shop_type       shop_types?      @relation(fields: [shop_type_id], references: [id])
  shop_features   shop_features?
  bots            bots?
  user_roles      user_roles[]
  user_activities user_activities[]
  product_types   product_types[]
  products        products[]
  customers       customers[]
  orders          orders[]

  @@index([owner_id])
  @@map("shops")
}

model shop_features {
  id                  String    @id @default(uuid()) @db.Uuid
  shop_id             String    @unique @db.Uuid
  plan                PlanTier  @default(free)
  plan_expires_at     DateTime?
  ai_auto_reply       Boolean   @default(false)
  voice_image_support Boolean   @default(false)
  marketing_banners   Boolean   @default(false)
  advanced_analytics  Boolean   @default(false)
  delivery_api        Boolean   @default(false)
  monthly_order_limit Int       @default(100)
  orders_this_month   Int       @default(0)
  limit_reset_at      DateTime?
  updated_at          DateTime  @updatedAt

  shop shops @relation(fields: [shop_id], references: [id])

  @@map("shop_features")
}

// ─── BOT ─────────────────────────────────────────

model bots {
  id              String    @id @default(uuid()) @db.Uuid
  shop_id         String    @unique @db.Uuid
  bot_token       String
  bot_username    String
  webhook_url     String?
  is_active       Boolean   @default(false)
  last_webhook_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  shop   shops    @relation(fields: [shop_id], references: [id])
  orders orders[]

  @@map("bots")
}

// ─── PRODUCTS ────────────────────────────────────

model product_types {
  id          String   @id @default(uuid()) @db.Uuid
  shop_id     String   @db.Uuid
  name        String
  description String?
  created_at  DateTime @default(now())

  shop     shops      @relation(fields: [shop_id], references: [id])
  products products[]

  @@unique([shop_id, name])
  @@map("product_types")
}

model products {
  id                  String    @id @default(uuid()) @db.Uuid
  shop_id             String    @db.Uuid
  product_type_id     String?   @db.Uuid
  name                String
  description         String?
  image_url           String?
  sku                 String?
  price               Decimal   @db.Decimal(12, 2)
  cost_price          Decimal?  @db.Decimal(12, 2)
  currency            String    @default("KHR")
  stock_quantity      Int       @default(0)
  low_stock_threshold Int       @default(5)
  is_available        Boolean   @default(true)
  is_pinned           Boolean   @default(false)
  sort_order          Int       @default(0)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  shop         shops           @relation(fields: [shop_id], references: [id])
  product_type product_types? @relation(fields: [product_type_id], references: [id])
  order_items  order_items[]

  @@index([shop_id, is_available])
  @@index([shop_id, is_pinned])
  @@index([shop_id, product_type_id])
  @@index([sku])
  @@map("products")
}

// ─── CUSTOMERS ───────────────────────────────────

model customers {
  id         String    @id @default(uuid()) @db.Uuid
  shop_id    String    @db.Uuid
  name       String?
  phone      String?
  address    String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  shop shops @relation(fields: [shop_id], references: [id])

  @@index([shop_id, phone])
  @@index([shop_id, deleted_at])
  @@map("customers")
}

// ─── ORDERS ──────────────────────────────────────

model orders {
  id                   String        @id @default(uuid()) @db.Uuid
  shop_id              String        @db.Uuid
  bot_id               String?       @db.Uuid
  customer_telegram_id BigInt?
  customer_name        String?
  customer_phone       String?
  customer_address     String?
  status               OrderStatus   @default(pending)
  subtotal             Decimal       @db.Decimal(12, 2)
  discount_amount      Decimal       @default(0) @db.Decimal(12, 2)
  total_amount         Decimal       @db.Decimal(12, 2)
  currency             String        @default("KHR")
  payment_method       PaymentMethod?
  payment_status       PaymentStatus @default(unpaid)
  payment_ref          String?
  paid_at              DateTime?
  delivery_provider    String?
  delivery_fee         Decimal?      @default(0) @db.Decimal(12, 2)
  note                 String?
  placed_via           PlacedVia     @default(bot)
  handled_by           String?       @db.Uuid
  order_number         String?       @db.VarChar(32)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt
  cancelled_at         DateTime?
  cancel_reason        String?

  shop         shops         @relation(fields: [shop_id], references: [id])
  bot          bots?         @relation(fields: [bot_id], references: [id])
  handled_user users?        @relation("OrderHandledBy", fields: [handled_by], references: [id])
  order_items  order_items[]

  @@index([shop_id, status])
  @@index([shop_id, created_at])
  @@index([shop_id, order_number])
  @@index([customer_telegram_id])
  @@index([payment_ref])
  @@unique([shop_id, order_number])
  @@map("orders")
}

model order_items {
  id           String  @id @default(uuid()) @db.Uuid
  order_id     String  @db.Uuid
  product_id   String  @db.Uuid
  product_name String
  unit_price   Decimal @db.Decimal(12, 2)
  quantity     Int
  subtotal     Decimal @db.Decimal(12, 2)

  order   orders   @relation(fields: [order_id], references: [id])
  product products @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@map("order_items")
}
